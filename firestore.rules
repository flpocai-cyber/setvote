rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Qualquer pessoa pode ler músicas, perfis, patrocinadores, fotos, shows
    match /songs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /sponsors/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /about_photos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /shows/{id} {
      allow read: if true;
      allow write: if request.auth != null;

      // Subcoleção de músicas do show
      match /songs/{songId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Qualquer visitante pode inserir voto ou dedicação, admin gerencia
    match /votes/{id} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    match /dedications/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Eventos futuros — só admin lê/escreve
    match /future_events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Votos de eventos futuros — qualquer um cria
    match /event_votes/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
